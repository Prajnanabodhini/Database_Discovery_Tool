# Example only — do not commit real credentials

MSSQL_SERVER=localhost
MSSQL_DATABASE=DatabaseName
MSSQL_DATABASES=
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

MSSQL_TRUSTED_CONNECTION=true
# MSSQL_USERNAME=
# MSSQL_PASSWORD=

MSSQL_ENCRYPT=no
MSSQL_TRUST_SERVER_CERTIFICATE=yes
MSSQL_QUERY_TIMEOUT_SECONDS=60

DISCOVERY_MODE=metadata+logic

# Canonical bounded-sampling controls.
SAMPLE_TABLES=true
SAMPLE_VIEWS=true
SAMPLE_LARGE_TABLES=true
SAMPLE_ROW_LIMIT=100
# Backward-compatible aliases used only when canonical controls are absent.
PROFILE_SAMPLE_ROWS=100
PROFILE_INCLUDE_SAMPLE_DATA=true
PROFILE_MASK_SENSITIVE_DATA=true
PROFILE_EXACT_ROW_COUNTS=false
# Separate safe ceiling for exact COUNT_BIG scans; increase only after explicit review.
PROFILE_EXACT_ROW_COUNT_THRESHOLD=100000
PROFILE_DISTINCT_VALUES=true
PROFILE_MAX_DISTINCT_VALUES=50
PROFILE_LARGE_TABLE_THRESHOLD=1000000

# Full Read-Only has separate, larger limits. Non-overridable ceilings are
# documented in OPERATOR_RUN_GUIDE.md and enforced when its policy is resolved.
FULL_READONLY_SAMPLE_ROW_LIMIT=500
FULL_READONLY_PROFILE_THRESHOLD=5000000
FULL_READONLY_EXACT_COUNT_THRESHOLD=500000
FULL_READONLY_RELATIONSHIP_THRESHOLD=5000000
FULL_READONLY_LOW_CARDINALITY_LIMIT=200
FULL_READONLY_EXTENDED_VALIDATION=true

SENSITIVITY_OVERRIDES_FILE=config/sensitivity_overrides.toml
GIT_EXPORT_SAMPLE_POLICY=exclude

DISCOVER_SQL_AGENT_JOBS=true
# Opt-in only. Exports hashed database-principal identities, never raw names or grants.
DISCOVER_SECURITY_METADATA=false

OUTPUT_ROOT=output
GIT_EXPORT_ROOT=git_export
SANITIZE_SERVER_NAME=true

WEB_HOST=127.0.0.1
WEB_PORT=8765
WEB_AUTO_OPEN_BROWSER=true

MAX_CONCURRENT_DISCOVERY_JOBS=1
ENABLE_THREE_RUN_COMPARISON=true
